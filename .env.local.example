# Anthropic API (обязательно) — симуляция пациента + грейдер
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (обязательно) — ИИ-консультант на /patients
OPENAI_API_KEY=sk-proj-...

# ElevenLabs TTS (старый вариант голоса, опционально)
ELEVENLABS_API_KEY=sk_...

# Voice mode — STT (Deepgram Nova-3)
DEEPGRAM_API_KEY=...

# Voice mode — TTS (Cartesia Sonic-2)
CARTESIA_API_KEY=sk_car_...

# Voice mode — LiveKit Cloud (WebRTC транспорт)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# URL бэкенда (по умолчанию localhost)
NEXT_PUBLIC_API_URL=http://localhost:8000
