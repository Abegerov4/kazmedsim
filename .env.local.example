# ─── Backend secrets (НЕ коммитить настоящие значения) ───────────
# Обязательно: Anthropic — симуляция пациента + оценка
ANTHROPIC_API_KEY=sk-ant-...

# Обязательно: OpenAI — ИИ-консультант на /patients
OPENAI_API_KEY=sk-proj-...

# Опционально: ElevenLabs TTS (голос)
ELEVENLABS_API_KEY=sk_...

# Опционально: Deepgram STT (распознавание речи)
DEEPGRAM_API_KEY=...

# ─── Backend runtime config ──────────────────────────────────────
# Список разрешённых origin'ов через запятую (URL фронта). Локально достаточно localhost.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Путь к SQLite. В Docker / Fly.io = /app/db/kazmedsim.db. Локально не указывать.
# DB_PATH=/app/db/kazmedsim.db

# ─── Frontend ─────────────────────────────────────────────────────
# URL задеплоенного бэкенда. На Vercel поставить такой же.
NEXT_PUBLIC_API_URL=http://localhost:8000
